// Пример общего серверного модуля, не готовая EPF/CFE.
// В 1С:Предприятии не запускался. Совместимость с конфигурациями не заявляется.
// Сборщик и сервер 1С должны работать на одной машине для loopback HTTP.

Функция ПрочитатьИзAPI(Токен, ОрганизацияOID, СоединениеID, Контур, Порт = 8778) Экспорт

    Если СтрДлина(СокрЛП(Токен)) < 24 Тогда
        ВызватьИсключение "Не задан локальный токен Bell";
    КонецЕсли;
    Соединение = Новый HTTPСоединение("127.0.0.1", Порт, , , , 15);
    Запрос = Новый HTTPЗапрос("/v1/notifications");
    Запрос.Заголовки.Вставить("Authorization", "Bearer " + СокрЛП(Токен));
    Запрос.Заголовки.Вставить("Accept", "application/json");
    Ответ = Соединение.Получить(Запрос);
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "Bell HTTP " + Строка(Ответ.КодСостояния);
    КонецЕсли;
    Возврат ПрочитатьОтветJSON(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8),
        ОрганизацияOID, СоединениеID, Контур);

КонецФункции

Функция ПрочитатьФайлJSON(ИмяФайла, ОрганизацияOID, СоединениеID, Контур) Экспорт

    ФайлJSON = Новый Файл(ИмяФайла);
    Если Не ФайлJSON.Существует() Тогда
        ВызватьИсключение "Bell: файл обмена не найден";
    КонецЕсли;
    Если ФайлJSON.Размер() > 8388608 Тогда
        ВызватьИсключение "Bell: файл обмена больше 8 МиБ";
    КонецЕсли;
    Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
    Попытка
        Текст = Чтение.Прочитать();
    Исключение
        Чтение.Закрыть();
        ВызватьИсключение "Bell: файл обмена не прочитан";
    КонецПопытки;
    Чтение.Закрыть();
    Возврат ПрочитатьОтветJSON(Текст, ОрганизацияOID, СоединениеID, Контур);

КонецФункции

Функция ПрочитатьОтветJSON(ТекстJSON, ОрганизацияOID, СоединениеID, Контур) Экспорт

    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ТекстJSON);
    Попытка
        Данные = ПрочитатьJSON(Чтение, Истина);
    Исключение
        Чтение.Закрыть();
        ВызватьИсключение "Bell: неверный JSON, импорт не выполнен";
    КонецПопытки;
    Чтение.Закрыть();
    Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
        ВызватьИсключение "Bell: ожидался JSON-объект";
    КонецЕсли;

    Элементы = Данные.Получить("items");
    Если Элементы = Неопределено Тогда
        Снимок = Данные;
    Иначе
        Снимок = Данные.Получить("snapshot");
    КонецЕсли;
    Если ТипЗнч(Снимок) <> Тип("Соответствие") Тогда
        ВызватьИсключение "Bell: нет последнего снимка";
    КонецЕсли;
    Контекст = Снимок.Получить("context");
    Если ТипЗнч(Контекст) <> Тип("Соответствие") Тогда
        ВызватьИсключение "Bell: нет контекста";
    КонецЕсли;
    Если Контекст.Получить("organization_id") <> ОрганизацияOID
        Или Контекст.Получить("connection_id") <> СоединениеID
        Или Контекст.Получить("contour") <> Контур
        Или Контекст.Получить("subject_type") = "person" Тогда
        ВызватьИсключение "Bell: контекст другой организации или контура";
    КонецЕсли;
    Версия = Снимок.Получить("schema_version");
    Если Версия <> "1.0" И Версия <> "1.2" И Версия <> "1.3" Тогда
        ВызватьИсключение "Bell: неподдерживаемая схема";
    КонецЕсли;
    Статус = Снимок.Получить("status");
    Если Контекст.Получить("verified") <> Истина
        Или (Статус <> "succeeded" И Статус <> "partial") Тогда
        ВызватьИсключение "Bell: нужен новый вход или проверка источника; прежние записи сохраняются";
    КонецЕсли;

    ЭтоОтветAPI = Элементы <> Неопределено;
    Если Не ЭтоОтветAPI Тогда
        Элементы = Снимок.Получить("notifications");
    КонецЕсли;
    Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
        ВызватьИсключение "Bell: нет массива уведомлений";
    КонецЕсли;
    Если ЭтоОтветAPI Тогда
        Страницы = Данные.Получить("pagination");
        Если ТипЗнч(Страницы) = Тип("Соответствие") Тогда
            Если Страницы.Получить("has_more") <> Ложь Тогда
                ВызватьИсключение "Bell: есть следующая страница; этот пример 1С пока читает только одну";
            КонецЕсли;
        ИначеЕсли Элементы.Количество() >= 1000 Тогда
            ВызватьИсключение "Bell: старый API достиг лимита выдачи";
        КонецЕсли;
    КонецЕсли;
    Если Не ЭтоОтветAPI И Элементы.Количество() > ?(Версия = "1.3", 2000, 200) Тогда
        ВызватьИсключение "Bell: превышен лимит снимка";
    КонецЕсли;

    Таблица = Новый ТаблицаЗначений;
    Для Каждого Имя Из СтрРазделить("ID,Заголовок,Текст,Отправитель,ДатаИсточника,Прочитанность,Ссылка", ",") Цикл
        Таблица.Колонки.Добавить(Имя);
    КонецЦикла;
    Идентификаторы = Новый Соответствие;
    Для Каждого Элемент Из Элементы Цикл
        Если ЭтоОтветAPI Тогда
            Запись = Элемент.Получить("record");
        Иначе
            Запись = Элемент;
        КонецЕсли;
        ID = Запись.Получить("id");
        Если ТипЗнч(ID) <> Тип("Строка") Или СтрДлина(ID) <> 68 Тогда
            ВызватьИсключение "Bell: неверный ID уведомления";
        КонецЕсли;
        Если Лев(ID, 4) <> "ntf_" Или Идентификаторы.Получить(ID) <> Неопределено Тогда
            ВызватьИсключение "Bell: неверный или повторный ID";
        КонецЕсли;
        Идентификаторы.Вставить(ID, Истина);
        СтрокаТаблицы = Таблица.Добавить();
        СтрокаТаблицы.ID = ID;
        СтрокаТаблицы.Заголовок = ДекодироватьТекст(Запись.Получить("title"));
        СтрокаТаблицы.Текст = ДекодироватьТекст(Запись.Получить("body"));
        СтрокаТаблицы.Отправитель = ДекодироватьТекст(Запись.Получить("sender"));
        СтрокаТаблицы.ДатаИсточника = Запись.Получить("occurred_at");
        СтрокаТаблицы.Прочитанность = Запись.Получить("read_state");
        СтрокаТаблицы.Ссылка = Запись.Получить("url");
    КонецЦикла;
    // Функция только возвращает данные. Регистры и документы базы не меняет.
    Результат = Новый Структура;
    Результат.Вставить("Уведомления", Таблица);
    Результат.Вставить("СтатусСнимка", Статус);
    Результат.Вставить("ДатаНаблюдения", Снимок.Получить("observed_at"));
    Результат.Вставить("ПолнаяИстория", Ложь);
    Возврат Результат;

КонецФункции

Функция ДекодироватьТекст(Значение)

    Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
        ВызватьИсключение "Bell: отсутствует текстовое поле";
    КонецЕсли;
    Если Значение.Получить("encoding") <> "base64" Или Значение.Получить("charset") <> "utf-8" Тогда
        ВызватьИсключение "Bell: неизвестная кодировка";
    КонецЕсли;
    Возврат ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Значение.Получить("data")), КодировкаТекста.UTF8);

КонецФункции
